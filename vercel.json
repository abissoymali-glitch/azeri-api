{
  "version": 2,
  "builds": [
    {
      "src": "api/sorgu.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["azeri.txt"]
      }
    }
  ],
  "routes": [
    {"src": "/api/sorgu", "dest": "api/sorgu.py"},
    {"src": "/sorgu", "dest": "api/sorgu.py"},
    {"src": "/istatistik", "dest": "api/sorgu.py"},
    {"src": "/admin/tum", "dest": "api/sorgu.py"},
    {"src": "/(.*)", "dest": "api/sorgu.py"}
  ]
}
